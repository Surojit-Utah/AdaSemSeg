# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/

# Logs and outputs
logs/
runs/
*.log
evaluation_results/

# Data and checkpoints
# Datasets and model weights (both hosted on Zenodo) are downloaded on demand
# via scripts/download_assets.py, not committed to this repo. Keep the directory
# structure under version control (via .gitkeep) but ignore the binaries.
!data/
!checkpoints/
checkpoints/**/*.pth.tar
checkpoints/**/*.pth
checkpoints/*.zip
!checkpoints/**/.gitkeep
Repo_checkpoints_excluded/

# Raw Penobscot source file (2.2GB) -- not redistributed; see data/Penobscot/process_data.py
# for how to obtain it and reproduce seismic.npy / seismic_labels.npy from it.
data/Penobscot/dataset.h5

# Dataset volumes -- downloaded from Zenodo (10.5281/zenodo.21764042) via
# scripts/download_assets.py, not committed here. split_train_val_test_*.json
# files stay tracked since they're small and define the paper's exact splits.
data/**/*.npy
data/**/*.zip

# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/
